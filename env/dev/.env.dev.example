ENV=dev
APP_NAME=audiometa-api
APP_TITLE=AudioMeta API
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

API_ROOT_BASE=v1/

FILE_UPLOAD_ENABLED=true
TMP_UPLOADED_FILES=/tmp/audiometa-uploads
METADATA_SESSION_DIR=/tmp/audiometa-metadata-sessions

# Optional: MusicBrainz / AcoustID (session upload with include_musicbrainz_analysis=true)
ACOUSTID_API_KEY=

# Optional: Audio Fingerprinter service
AFP_BASE_URL=localhost
AFP_PORT=3002
AFP_POST_ENDPOINT=fingerprint-audio
